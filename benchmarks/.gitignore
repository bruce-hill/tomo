# Python bytecode cache from the driver/plotter.
__pycache__/
# Downloaded reference implementations (other languages) — never tracked.
fetched/
# Compiled binaries and per-language build scratch.
.build/
# Tomo build artifacts emitted next to the tracked sources.
tomo/.tomo/
tomo/*
!tomo/*.tm
# Raw measured timings (machine-specific) and the vector graphs. The PNG
# graphs ARE checked in (a representative snapshot embedded in README.md);
# everything else here regenerates locally.
results.json
results.svg
results-*.svg
