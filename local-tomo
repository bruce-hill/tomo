#!/bin/sh
# Normalize uname's spellings to Zig platform keys (Darwin/arm64/amd64 etc.):
case "$(uname -s)" in
    Darwin) os=macos ;;
    *) os=$(uname -s | tr '[:upper:]' '[:lower:]') ;;
esac
case "$(uname -m)" in
    arm64) arch=aarch64 ;;
    amd64) arch=x86_64 ;;
    *) arch=$(uname -m) ;;
esac
platform="$arch-$os"
if ! [ -e "./build/$platform/tomo/bin/tomo" ]; then
    make -j
fi
exec "./build/$platform/tomo/bin/tomo" "$@"
